datasource db {
  provider     = "mongodb"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

generator client {
  provider = "prisma-client-js"
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum RbacRole {
  ADMIN
  LEADER
  MEMBER
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

enum TeamRole {
  TEAM_LEAD
  FRONTEND_DEVELOPER
  BACKEND_DEVELOPER
  FULLSTACK_ENGINEER
  QA_ENGINEER
  UI_UX_DESIGNER
  DEVOPS_ENGINEER
  PRODUCT_MANAGER
  BUSINESS_ANALYST
  VIEWER
}

enum ProjectRole {
  PROJECT_LEAD
  DEVELOPER
  TESTER
  DESIGNER
  OBSERVER
}

enum RecordStatus {
  ACTIVE
  ARCHIVED
  DEACTIVATED
  REMOVED
}

model Workspace {
  id              String            @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  key             String            @unique
  templateType    String            @map("template_type")
  boardName       String            @map("board_name")
  description     String?
  sprintDuration  Int?              @default(2) @map("sprint_duration")
  wipLimit        Int?              @default(5) @map("wip_limit")
  createdAt       DateTime          @default(now()) @map("created_at")
  status          RecordStatus      @default(ACTIVE)
  tasks           Task[]
  scheduleEvents  ScheduleEvent[]
  ownerId         String?           @map("owner_id") @db.ObjectId
  owner           User?             @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  projects        Project[]
  workspaceMembers WorkspaceMember[]
  invitations     Invitation[]
  teams           Team[]

  @@index([ownerId])
  @@map("workspaces")
}

model User {
  id                     String            @id @default(auto()) @map("_id") @db.ObjectId
  name                   String
  email                  String            @unique
  password               String?
  role                   String?           @default("Full Stack Engineer")
  dept                   String?           @default("Core Engineering")
  location               String?
  githubUrl              String?           @map("github_url")
  linkedinUrl            String?           @map("linkedin_url")
  websiteUrl             String?           @map("workspace_url") // Keep schema-level map compatibility
  otherLinks             String?           @map("other_links")
  hasConfiguredWorkspace Boolean?          @default(false) @map("has_configured_workspace")
  authProvider           AuthProvider      @default(LOCAL) @map("auth_provider")
  rbacRole               RbacRole          @default(MEMBER) @map("rbac_role")
  tokenVersion           Int               @default(1) @map("token_version")
  createdAt              DateTime          @default(now()) @map("created_at")
  tasks                  Task[]
  notifications          Notification[]
  ownedWorkspaces        Workspace[]       @relation("WorkspaceOwner")
  ownedGoals             Goal[]            @relation("GoalOwner")
  ownedTeams             Team[]            @relation("TeamOwner")
  teamOwnerId            String?           @map("team_owner_id") @db.ObjectId
  teamOwner              User?             @relation("TeamMembershipOwner", fields: [teamOwnerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  teamMembers            User[]            @relation("TeamMembershipOwner")
  workspaceMembers       WorkspaceMember[]
  sentInvitations        Invitation[]
  auditLogsActor         AuditLog[]        @relation("AuditActor")
  auditLogsTarget        AuditLog[]        @relation("AuditTarget")
  ledTeams               Team[]            @relation("TeamLead")

  @@index([teamOwnerId])
  @@map("users")
}

model Task {
  id                  String     @id @default(auto()) @map("_id") @db.ObjectId
  title               String
  descText            String?    @map("desc_text")
  status              String?    @default("todo")
  priority            String?    @default("Medium")
  epic                String?
  assigneeId          String?    @map("assignee_id") @db.ObjectId
  assignee            User?      @relation(fields: [assigneeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workspaceId         String?    @map("workspace_id") @db.ObjectId
  workspace           Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  commentCount        Int        @default(0) @map("comment_count")
  watcherCount        Int        @default(0) @map("watcher_count")
  voteCount           Int        @default(0) @map("vote_count")
  worklogTotalSeconds Int        @default(0) @map("worklog_total_seconds")
  createdAt           DateTime   @default(now()) @map("created_at")
  completedAt         DateTime?  @map("completed_at")

  @@index([workspaceId])
  @@index([assigneeId])
  @@index([status])
  @@index([createdAt])
  @@index([workspaceId, status, priority])
  @@index([workspaceId, assigneeId, status])
  @@map("tasks")
}

model Goal {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  descText    String?  @map("desc_text")
  owner       String   @default("You")
  targetDate  String?  @map("target_date")
  progress    Int      @default(0)
  status      String   @default("on_track")
  createdAt   DateTime @default(now()) @map("created_at")
  ownerId     String?  @map("owner_id") @db.ObjectId
  ownerUser   User?    @relation("GoalOwner", fields: [ownerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workspaceId String?  @map("workspace_id") @db.ObjectId
  
  @@index([ownerId])
  @@index([workspaceId])
  @@map("goals")
}

model Team {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  descText    String?      @map("desc_text")
  membersText String?      @default("") @map("members_text") // backward compatibility
  ownerId     String?      @map("owner_id") @db.ObjectId
  owner       User?        @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status      RecordStatus @default(ACTIVE)
  teamLeadId  String?      @map("team_lead_id") @db.ObjectId
  teamLead    User?        @relation("TeamLead", fields: [teamLeadId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  teamMembers TeamMember[]
  workspaceId String       @map("workspace_id") @db.ObjectId
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([teamLeadId])
  @@index([workspaceId])
  @@unique([workspaceId, name])
  @@map("teams")
}

model ScheduleEvent {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  descText    String?    @map("desc_text")
  eventDate   String     @map("event_date")
  startTime   String?    @map("start_time")
  endTime     String?    @map("end_time")
  workspaceId String?    @map("workspace_id") @db.ObjectId
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([workspaceId])
  @@index([eventDate])
  @@map("schedule_events")
}

model OtpCode {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  code      String
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  @@map("otp_codes")
}

model AuthToken {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  email         String
  token         String   @unique
  type          String   // OTP, EMAIL_VERIFICATION, PASSWORD_RESET, WORKSPACE_INVITATION
  workspaceId   String?  @map("workspace_id") @db.ObjectId
  workspaceRole String?  @map("workspace_role")
  expiresAt     DateTime @map("expires_at")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([email])
  @@index([expiresAt])
  @@map("auth_tokens")
}

model Notification {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  title     String?
  message   String
  type      String    @default("info") // categories: INVITATION, TEAM, PROJECT, TASK, COMMENT, MENTION, ROLE_CHANGE, SYSTEM
  link      String?
  icon      String?
  read      Boolean   @default(false)
  deleted   Boolean   @default(false)
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  userId    String?   @map("user_id") @db.ObjectId
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  workspaceId String?   @map("workspace_id") @db.ObjectId
  createdBy   String?   @map("created_by") @db.ObjectId
  
  @@index([userId])
  @@index([workspaceId])
  @@map("notifications")
}

model Project {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  key         String
  description String?
  status      RecordStatus   @default(ACTIVE)
  workspaceId String         @map("workspace_id") @db.ObjectId
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now()) @map("created_at")
  projectMembers ProjectMember[]

  @@index([workspaceId])
  @@unique([workspaceId, key])
  @@unique([workspaceId, name])
  @@map("projects")
}

model ProjectMember {
  id                String          @id @default(auto()) @map("_id") @db.ObjectId
  projectId         String          @map("project_id") @db.ObjectId
  project           Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspaceMemberId String          @map("workspace_member_id") @db.ObjectId
  workspaceMember   WorkspaceMember @relation(fields: [workspaceMemberId], references: [id], onDelete: Cascade)
  role              ProjectRole     @default(DEVELOPER)
  joinedAt          DateTime        @default(now()) @map("joined_at")

  @@index([projectId])
  @@index([workspaceMemberId])
  @@unique([projectId, workspaceMemberId])
  @@map("project_members")
}

model WorkspaceMember {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId      String         @map("workspace_id") @db.ObjectId
  workspace        Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId           String         @map("user_id") @db.ObjectId
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role             WorkspaceRole  @default(MEMBER)
  status           RecordStatus   @default(ACTIVE)
  joinedAt         DateTime       @default(now()) @map("joined_at")
  teamMemberships  TeamMember[]
  projectMemberships ProjectMember[]

  @@index([workspaceId])
  @@index([userId])
  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

model TeamMember {
  id                String          @id @default(auto()) @map("_id") @db.ObjectId
  teamId            String          @map("team_id") @db.ObjectId
  team              Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  workspaceMemberId String          @map("workspace_member_id") @db.ObjectId
  workspaceMember   WorkspaceMember @relation(fields: [workspaceMemberId], references: [id], onDelete: Cascade)
  role              TeamRole        @default(FULLSTACK_ENGINEER)
  status            RecordStatus    @default(ACTIVE)
  joinedAt          DateTime        @default(now()) @map("joined_at")

  @@index([teamId])
  @@index([workspaceMemberId])
  @@unique([teamId, workspaceMemberId])
  @@map("team_members")
}

model Invitation {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  email         String
  workspaceId   String        @map("workspace_id") @db.ObjectId
  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceRole WorkspaceRole @default(MEMBER)
  teamId        String?       @map("team_id") @db.ObjectId
  teamRole      TeamRole?
  projectId     String?       @map("project_id") @db.ObjectId
  projectRole   ProjectRole?
  token         String        @unique
  status        String        @default("PENDING") // PENDING, ACCEPTED, DECLINED, EXPIRED, REVOKED
  expiresAt     DateTime      @map("expires_at")
  invitedById   String        @map("invited_by_id") @db.ObjectId
  invitedBy     User          @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now()) @map("created_at")

  @@index([workspaceId])
  @@index([email])
  @@map("invitations")
}

model Permission {
  id          String                   @id @default(auto()) @map("_id") @db.ObjectId
  name        String                   @unique // e.g. "workspace.manage"
  description String?
  workspaceRoles WorkspaceRolePermission[]
  teamRoles      TeamRolePermission[]

  @@map("permissions")
}

model WorkspaceRolePermission {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  role         WorkspaceRole
  permissionId String        @map("permission_id") @db.ObjectId
  permission   Permission    @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@index([permissionId])
  @@unique([role, permissionId])
  @@map("workspace_role_permissions")
}

model TeamRolePermission {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  role         TeamRole
  permissionId String     @map("permission_id") @db.ObjectId
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@index([permissionId])
  @@unique([role, permissionId])
  @@map("team_role_permissions")
}

model AuditLog {
  id           String       @id @default(auto()) @map("_id") @db.ObjectId
  actorId      String?      @map("actor_id") @db.ObjectId
  actor        User?        @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetUserId String?      @map("target_user_id") @db.ObjectId
  targetUser   User?        @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  action       String       // e.g. "MemberInvited", "RoleChanged"
  resourceType String       @map("resource_type") // e.g. "Workspace", "Team", "Project"
  resourceId   String?      @map("resource_id") @db.ObjectId
  oldValue     String?      @map("old_value")
  newValue     String?      @map("new_value")
  timestamp    DateTime     @default(now())
  ipAddress    String?      @map("ip_address")
  browser      String?
  device       String?
  userAgent    String?      @map("user_agent")

  @@index([actorId])
  @@index([targetUserId])
  @@map("audit_logs")
}

model Epic {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  workspaceId String   @map("workspace_id") @db.ObjectId
  createdAt   DateTime @default(now())

  @@unique([workspaceId, name])
}

model Milestone {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  workspaceId String   @map("workspace_id") @db.ObjectId
  createdAt   DateTime @default(now())

  @@unique([workspaceId, name])
}

model Release {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  version     String
  workspaceId String   @map("workspace_id") @db.ObjectId
  createdAt   DateTime @default(now())

  @@unique([workspaceId, version])
}

model Wiki {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  content     String
  workspaceId String   @map("workspace_id") @db.ObjectId
  createdAt   DateTime @default(now())

  @@unique([workspaceId, title])
}

model AutomationRule {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  workspaceId String   @map("workspace_id") @db.ObjectId
  createdAt   DateTime @default(now())

  @@unique([workspaceId, name])
}

model CustomField {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  workspaceId String   @map("workspace_id") @db.ObjectId
  createdAt   DateTime @default(now())

  @@unique([workspaceId, name])
}

model Label {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  workspaceId String   @map("workspace_id") @db.ObjectId
  createdAt   DateTime @default(now())

  @@unique([workspaceId, name])
}

model Tag {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  workspaceId String   @map("workspace_id") @db.ObjectId
  createdAt   DateTime @default(now())

  @@unique([workspaceId, name])
}

model Webhook {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  url         String
  workspaceId String   @map("workspace_id") @db.ObjectId
  createdAt   DateTime @default(now())

  @@unique([workspaceId, url])
}

model UserSettings {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @unique @map("user_id") @db.ObjectId
  theme       String   @default("jira-dark")
  locale      String   @default("en-US")
  timeZone    String   @default("UTC") @map("time_zone")
  keybindings String?  @default("default")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("user_settings")
}

model UserPreferences {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  userId             String   @unique @map("user_id") @db.ObjectId
  defaultWorkspaceId String?  @map("default_workspace_id") @db.ObjectId
  defaultProjectId   String?  @map("default_project_id") @db.ObjectId
  compactView        Boolean  @default(false) @map("compact_view")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("user_preferences")
}

model NotificationPreferences {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @unique @map("user_id") @db.ObjectId
  emailEnabled Boolean  @default(true) @map("email_enabled")
  inAppEnabled Boolean  @default(true) @map("in_app_enabled")
  slackEnabled Boolean  @default(false) @map("slack_enabled")
  pushEnabled  Boolean  @default(true) @map("push_enabled")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("notification_preferences")
}

model RecentView {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @map("user_id") @db.ObjectId
  workspaceId String   @map("workspace_id") @db.ObjectId
  entityType  String   @map("entity_type") // WORKSPACE, PROJECT, BOARD, TASK
  entityId    String   @map("entity_id") @db.ObjectId
  entityName  String   @map("entity_name")
  entityKey   String?  @map("entity_key")
  visitedAt   DateTime @default(now()) @map("visited_at")

  @@index([userId, visitedAt])
  @@index([workspaceId])
  @@map("recent_views")
}

model SearchHistory {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @map("user_id") @db.ObjectId
  workspaceId String   @map("workspace_id") @db.ObjectId
  query       String
  searchedAt  DateTime @default(now()) @map("searched_at")

  @@index([userId, searchedAt])
  @@map("search_history")
}

model Board {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  projectId   String   @map("project_id") @db.ObjectId
  workspaceId String   @map("workspace_id") @db.ObjectId
  type        String   @default("KANBAN") // KANBAN, SCRUM
  columns     String?  // JSON stringified column config
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([projectId])
  @@index([workspaceId])
  @@map("boards")
}

model BoardView {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  boardId     String   @map("board_id") @db.ObjectId
  name        String
  filterQuery String?  @map("filter_query")
  swimlanes   String?  @default("ASSIGNEE")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([boardId])
  @@map("board_views")
}

model Sprint {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  goal        String?
  projectId   String    @map("project_id") @db.ObjectId
  workspaceId String    @map("workspace_id") @db.ObjectId
  status      String    @default("FUTURE") // FUTURE, ACTIVE, CLOSED
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([projectId, status])
  @@index([workspaceId])
  @@map("sprints")
}

model TaskComment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  taskId    String   @map("task_id") @db.ObjectId
  authorId  String   @map("author_id") @db.ObjectId
  content   String
  edited    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([taskId, createdAt])
  @@map("task_comments")
}

model TaskHistory {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  taskId    String   @map("task_id") @db.ObjectId
  actorId   String   @map("actor_id") @db.ObjectId
  field     String
  oldValue  String?  @map("old_value")
  newValue  String?  @map("new_value")
  changedAt DateTime @default(now()) @map("changed_at")

  @@index([taskId, changedAt])
  @@map("task_history")
}

model TaskWorklog {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  taskId           String   @map("task_id") @db.ObjectId
  authorId         String   @map("author_id") @db.ObjectId
  timeSpentSeconds Int      @map("time_spent_seconds")
  description      String?
  startedAt        DateTime @map("started_at")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([taskId])
  @@map("task_worklogs")
}

model TaskWatcher {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  taskId    String   @map("task_id") @db.ObjectId
  userId    String   @map("user_id") @db.ObjectId
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([taskId, userId])
  @@index([taskId])
  @@map("task_watchers")
}

model TaskVote {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  taskId    String   @map("task_id") @db.ObjectId
  userId    String   @map("user_id") @db.ObjectId
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([taskId, userId])
  @@index([taskId])
  @@map("task_votes")
}

model TaskRelation {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sourceTaskId String   @map("source_task_id") @db.ObjectId
  targetTaskId String   @map("target_task_id") @db.ObjectId
  relationType String   @map("relation_type") // BLOCKS, IS_BLOCKED_BY, CLONES, RELATES_TO
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([sourceTaskId])
  @@index([targetTaskId])
  @@map("task_relations")
}

model Attachment {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  taskId     String   @map("task_id") @db.ObjectId
  fileName   String   @map("file_name")
  fileUrl    String   @map("file_url")
  fileSize   Int      @map("file_size")
  mimeType   String   @map("mime_type")
  uploaderId String   @map("uploader_id") @db.ObjectId
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([taskId])
  @@map("attachments")
}

model AutomationTemplate {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  triggerType String   @map("trigger_type")
  actionsJson String   @map("actions_json")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("automation_templates")
}

model AutomationRun {
  id     String   @id @default(auto()) @map("_id") @db.ObjectId
  ruleId String   @map("rule_id") @db.ObjectId
  status String // SUCCESS, FAILED
  output String?
  runAt  DateTime @default(now()) @map("run_at")

  @@index([ruleId])
  @@map("automation_runs")
}

model ApiToken {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  userId      String    @map("user_id") @db.ObjectId
  name        String
  tokenHash   String    @unique @map("token_hash")
  scopes      String[]  @default(["read", "write"])
  expiresAt   DateTime? @map("expires_at")
  lastUsedAt  DateTime? @map("last_used_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("api_tokens")
}

model Integration {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String   @map("workspace_id") @db.ObjectId
  provider    String   // GITHUB, SLACK, FIGMA, GITLAB
  configJson  String   @map("config_json")
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([workspaceId, provider])
  @@map("integrations")
}

model OrganizationSettings {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId        String   @unique @map("workspace_id") @db.ObjectId
  allowedEmailDomain String?  @map("allowed_email_domain")
  enforceSso         Boolean  @default(false) @map("enforce_sso")
  allowPublicSharing Boolean  @default(true) @map("allow_public_sharing")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("organization_settings")
}

model ProjectTemplate {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  category    String   // SOFTWARE, MARKETING, DEVOPS, DESIGN
  description String?
  configJson  String   @map("config_json")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("project_templates")
}

model Mention {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  taskId      String   @map("task_id") @db.ObjectId
  commentId   String?  @map("comment_id") @db.ObjectId
  mentionedBy String   @map("mentioned_by") @db.ObjectId
  userId      String   @map("user_id") @db.ObjectId
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([taskId])
  @@map("mentions")
}

model Archive {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String   @map("workspace_id") @db.ObjectId
  entityType  String   @map("entity_type") // PROJECT, TASK, WIKI
  entityId    String   @map("entity_id") @db.ObjectId
  payloadJson String   @map("payload_json")
  archivedBy  String   @map("archived_by") @db.ObjectId
  archivedAt  DateTime @default(now()) @map("archived_at")

  @@index([workspaceId])
  @@index([entityId])
  @@map("archives")
}
