# Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=your_32byte_min_jwt_secret_key_here
JWT_REFRESH_SECRET=your_32byte_min_jwt_refresh_secret_key_here
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Prisma Database Connection URL (MongoDB)
DATABASE_URL="mongodb://localhost:27017/jira_clone"

# Google OAuth
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com

# Nodemailer SMTP Configuration for OTPs/Password Reset and member invites
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
