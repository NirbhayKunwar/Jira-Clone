# Server Configuration
PORT=5000
JWT_SECRET=your_jwt_secret_key_here

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_NAME=jira_clone

# Prisma Database Connection URL
DATABASE_URL="postgresql://postgres:your_db_password_here@localhost:5432/jira_clone?schema=public"

# (Optional) Nodemailer SMTP Configuration for OTPs/Password Reset
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
