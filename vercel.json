{
    "services": {
        "frontend": {
            "root": "frontend",
            "framework": "vite"
        },
        "backend": {
            "root": "backend",
            "entrypoint": "server.js"
        }
    },
    "rewrites": [
        {
            "source": "/api(/.*)?",
            "destination": {
                "type": "service",
                "service": "backend"
            }
        },
        {
            "source": "/assets/:path*",
            "destination": {
                "type": "service",
                "service": "frontend"
            }
        },
        {
            "source": "/:path*(.js|.css|.png|.jpg|.jpeg|.gif|.svg|.ico|.json|.woff|.woff2|.ttf)",
            "destination": {
                "type": "service",
                "service": "frontend"
            }
        },
        {
            "source": "/:path*",
            "destination": {
                "type": "service",
                "service": "frontend",
                "path": "/index.html"
            }
        }
    ]
}
